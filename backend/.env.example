APP_ENV=development

# MySQL connection. Replace YOUR_PASSWORD with your MySQL root password.
# The database "cartium" is created automatically by the seed script.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/cartium

# Generate with:  py -3.12 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Frontend address allowed to call the API
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay TEST keys: Razorpay Dashboard > Test Mode > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-test-secret

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# AI shopping assistant: huggingface.co > Settings > Access Tokens > Fine-grained,
# tick "Make calls to Inference Providers"
HUGGINGFACE_API_KEY=hf_xxxxxxxx
# Any chat model that Hugging Face Inference Providers serves (check the model page's "Inference Providers" box)
AI_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Using Google Gemini instead (free key at aistudio.google.com/apikey):
# HUGGINGFACE_CHAT_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# HUGGINGFACE_API_KEY=your-gemini-key
# AI_MODEL_NAME=gemini-3-flash-preview
