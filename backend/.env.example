APP_ENV=development

# MySQL connection. Replace YOUR_PASSWORD with your MySQL root password.
# The database "cartium" is created automatically by the seed script.
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/cartium

# Generate with:  py -3.12 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Frontend address allowed to call the API
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
